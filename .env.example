# Public Supabase values are safe for the browser. Keep all other values server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate once with: openssl rand -base64 32
SEED_CREDENTIAL_ENCRYPTION_KEY=

# GitHub App credentials
# Create at: https://github.com/settings/apps
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# RSA private key (PEM). Use \n for newlines when setting as an env var.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Supabase OAuth (for users to connect their Supabase accounts)
# Create at: https://supabase.com/dashboard/account/oauth/apps
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
SUPABASE_OAUTH_SCOPES=organizations.read projects.read database.write

# Vercel Integration (for users to connect their Vercel accounts)
# Create at: https://vercel.com/dashboard/integrations/new
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_INTEGRATION_SLUG=

# OpenAI (Seed-level fallback — users provide their own BYOK key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Seed application URL (used for OAuth callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set in production to enable username.yourdomain.com dashboards
NEXT_PUBLIC_ROOT_DOMAIN=

# Set to "true" to run without a Supabase backend (local demo only)
SEED_DEMO_MODE=true
